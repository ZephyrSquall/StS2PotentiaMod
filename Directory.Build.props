<Project>
    <PropertyGroup>
        <!-- Megadot current version is 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->
        <!-- MegaDot / Godot 4.5.1 mono executable used for export-pack when publishing -->
        <GodotPath>/media/SSD1/Modding/SlayTheSpire2/OldGodot/Godot_v4.5.1-stable_mono_linux_x86_64/Godot_v4.5.1-stable_mono_linux.x86_64</GodotPath>
        <!-- Examples for Windows, Linux, Mac -->
        <!-- C:/megadot/MegaDot_v4.5.1-stable_mono_win64.exe -->
        <!-- /usr/lib/megadot/MegaDot_v4.5.1-stable_mono_linux.x86_64 -->
        <!-- /Users/user/Applications/Megadot.app/Contents/MacOS/Godot -->

        <!-- If sts2 is not found automatically, uncomment the following and set it manually -->
        <Sts2Path>/media/SSD1/SteamLibrary/steamapps/common/Slay the Spire 2/</Sts2Path>
    </PropertyGroup>
</Project>